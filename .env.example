# Snookerclub Node-app (optioneel — Docker zet deze zelf)
# Kopieer naar .env: cp .env.example .env

HOST=127.0.0.1
PORT=9091
WEBHOST_BASE_PATH=/webhost/snooker
SNOOKER_DATA_DIR=./data
NODE_ENV=development

# Tijdzone voor seizoenen, agenda en datums (augustus–juli)
TZ=Europe/Amsterdam
CLUB_TZ=Europe/Amsterdam

# Optioneel bij lokale builds / health-info
APP_VERSION=1.9.0
APP_REVISION=local
BUILD_DATE=
